NODE_ENV=development
PORT=3000

# Databas - app_user (runtime, begränsade rättigheter). Skapas av migrate.js.
DATABASE_URL=postgresql://app_user:REPLACE_WITH_APP_USER_PASSWORD@localhost:5432/nobomo?sslmode=require

# Lösenordet migrate.js sätter på app_user. Endast [A-Za-z0-9_-], minst 16 tecken.
APP_USER_PASSWORD=replace-with-strong-random-password

# Databas - superuser för migrationer (DDL-rättigheter). På Railway: ${{Postgres.DATABASE_URL}}
MIGRATION_DATABASE_URL=postgresql://postgres:password@localhost:5432/nobomo?sslmode=require

# JWT
JWT_SECRET=replace-with-64-char-random-hex-value-here
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_MAX_AGE_SECONDS=604800

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session (för OAuth-handskakning)
SESSION_SECRET=replace-with-64-char-random-hex-value-here

# Email (lösenordsåterställning)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=smtp-password
EMAIL_FROM=noreply@example.com
APP_URL=http://localhost:3000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
